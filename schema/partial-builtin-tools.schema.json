{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Built-in AI Tools Configuration",
  "description": "Configuration for enabling built-in AI tools in ProActions workflows",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "ContainerInfoTools",
        "ContentReadTools",
        "ContentWriteTools",
        "DocumentInfoTools",
        "FeedbackTools",
        "UserInfoTools",
        "UtilityTools",
        "addFeedback",
        "addJsonFeedback",
        "addKeyValueFeedback",
        "addMetricsFeedback",
        "addPureTextTags",
        "addTableFeedback",
        "clearPureTextTags",
        "getChannel",
        "getContainerChannel",
        "getContainerId",
        "getContainerLoid",
        "getContainerMetadata",
        "getContainerMetadataString",
        "getContainerObjectType",
        "getContainerProductName",
        "getContainerSystemMetadata",
        "getContainerSystemMetadataString",
        "getContainerTextContent",
        "getContainerUsageTickets",
        "getContainerUsageTicketsString",
        "getContainerUuid",
        "getContainerVirtualAttributes",
        "getContainerVirtualAttributesString",
        "getContainerWorkflowStatus",
        "getContainerXmlContents",
        "getDocumentId",
        "getDocumentIssueDate",
        "getDocumentLoid",
        "getDocumentName",
        "getDocumentUuid",
        "getDocumentWorkfolder",
        "getMetadata",
        "getMetadataString",
        "getObjectType",
        "getParagraphText",
        "getParagraphXML",
        "getProductName",
        "getPureText",
        "getSelectedElement",
        "getSelectedElementXpath",
        "getSelectedText",
        "getSelectedXML",
        "getSystemMetadata",
        "getSystemMetadataString",
        "getTextAtXpath",
        "getTextContent",
        "getUsageTickets",
        "getUsageTicketsString",
        "getUserFullName",
        "getUserGroups",
        "getUserMetadata",
        "getUserMetadataString",
        "getUserName",
        "getUserSystemMetadata",
        "getUserSystemMetadataString",
        "getUserTeams",
        "getVirtualAttributes",
        "getVirtualAttributesString",
        "getWorkflowStatus",
        "getXmlAtXpath",
        "getXmlContent",
        "insertTextAtCursor",
        "insertTextAtXpath",
        "insertXmlAtCursor",
        "insertXmlAtXpath",
        "isReadonly",
        "isTextSelected",
        "markdownToHtml",
        "replaceTextAtCursor",
        "replaceTextAtCursorParagraph",
        "replaceTextAtXpath",
        "replaceXmlAtCursor",
        "replaceXmlAtCursorParagraph",
        "replaceXmlAtXpath",
        "setIndeterminateProgress",
        "showNotification",
        "stripMarkdown",
        "updateProgress",
        "updateStepProgress",
        "validateAndRepairXml",
        "xmlToMarkdown"
      ],
      "description": "Enable all tools from a class by specifying the class name, or enable a single tool by its name"
    },
    {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "ContentReadTools",
            "ContentWriteTools",
            "FeedbackTools",
            "DocumentInfoTools",
            "ContainerInfoTools",
            "UserInfoTools",
            "UtilityTools"
          ],
          "description": "Tool class name"
        },
        "only": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Only enable these specific tools from the class (optional)"
        },
        "xpaths": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Named XPath mappings available as tool parameters (optional)"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "alias",
        "tool"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "description": "Name of the new virtual tool (how the AI will see it)"
        },
        "tool": {
          "type": "string",
          "enum": [
            "getTextContent",
            "getPureText",
            "getXmlContent",
            "getSelectedText",
            "getSelectedXML",
            "getParagraphText",
            "getParagraphXML",
            "getXmlAtXpath",
            "getTextAtXpath",
            "isTextSelected",
            "getSelectedElement",
            "getSelectedElementXpath",
            "getContainerTextContent",
            "getContainerXmlContents",
            "insertTextAtCursor",
            "insertTextAtXpath",
            "insertXmlAtCursor",
            "insertXmlAtXpath",
            "replaceTextAtCursor",
            "replaceTextAtCursorParagraph",
            "replaceTextAtXpath",
            "replaceXmlAtCursor",
            "replaceXmlAtCursorParagraph",
            "replaceXmlAtXpath",
            "addPureTextTags",
            "clearPureTextTags",
            "addFeedback",
            "updateProgress",
            "updateStepProgress",
            "setIndeterminateProgress",
            "addTableFeedback",
            "addJsonFeedback",
            "addKeyValueFeedback",
            "addMetricsFeedback",
            "showNotification",
            "getDocumentId",
            "getDocumentLoid",
            "getDocumentUuid",
            "getDocumentName",
            "getDocumentIssueDate",
            "getObjectType",
            "getWorkflowStatus",
            "getProductName",
            "getChannel",
            "getMetadata",
            "getMetadataString",
            "getSystemMetadata",
            "getSystemMetadataString",
            "getVirtualAttributes",
            "getVirtualAttributesString",
            "getUsageTickets",
            "getUsageTicketsString",
            "isReadonly",
            "getDocumentWorkfolder",
            "getContainerId",
            "getContainerLoid",
            "getContainerUuid",
            "getContainerObjectType",
            "getContainerWorkflowStatus",
            "getContainerProductName",
            "getContainerChannel",
            "getContainerMetadata",
            "getContainerMetadataString",
            "getContainerSystemMetadata",
            "getContainerSystemMetadataString",
            "getContainerVirtualAttributes",
            "getContainerVirtualAttributesString",
            "getContainerUsageTickets",
            "getContainerUsageTicketsString",
            "getUserName",
            "getUserFullName",
            "getUserGroups",
            "getUserTeams",
            "getUserMetadata",
            "getUserMetadataString",
            "getUserSystemMetadata",
            "getUserSystemMetadataString",
            "xmlToMarkdown",
            "markdownToHtml",
            "validateAndRepairXml",
            "stripMarkdown"
          ],
          "description": "Underlying tool to call when this alias is invoked"
        },
        "description": {
          "type": "string",
          "description": "Optional description override for the AI (replaces the original tool description)"
        },
        "args": {
          "type": "object",
          "description": "Preset arguments to pass to the underlying tool (merged with AI-provided arguments)"
        }
      },
      "additionalProperties": false
    }
  ]
}