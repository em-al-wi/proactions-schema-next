{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Built-in AI Tools Configuration",
  "description": "Configuration for enabling built-in AI tools in ProActions workflows",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "ContainerInfoTools",
        "ContentTools",
        "CustomTools",
        "DocumentInfoTools",
        "FeedbackTools",
        "HighlightTools",
        "HubMcp",
        "StoryEditor",
        "ToolDiscovery",
        "UserInfoTools",
        "UserInteractionTools",
        "UtilityTools",
        "activateTools",
        "addFeedback",
        "addJsonFeedback",
        "addKeyValueFeedback",
        "addMetricsFeedback",
        "addPureTextTags",
        "addTableFeedback",
        "appendParagraph",
        "askConfirmation",
        "askFreeformQuestion",
        "askMultipleChoice",
        "askSingleChoice",
        "callMcpTool",
        "clearMarks",
        "clearPureTextTags",
        "getChannel",
        "getContainerChannel",
        "getContainerId",
        "getContainerLoid",
        "getContainerMetadata",
        "getContainerMetadataString",
        "getContainerObjectType",
        "getContainerProductName",
        "getContainerSystemMetadata",
        "getContainerSystemMetadataString",
        "getContainerTextContent",
        "getContainerUsageTickets",
        "getContainerUsageTicketsString",
        "getContainerUuid",
        "getContainerVirtualAttributes",
        "getContainerVirtualAttributesString",
        "getContainerWorkflowStatus",
        "getContainerXmlContents",
        "getCurrentTimestamp",
        "getDocumentId",
        "getDocumentIssueDate",
        "getDocumentLoid",
        "getDocumentName",
        "getDocumentSummaryInfo",
        "getDocumentUuid",
        "getDocumentWorkfolder",
        "getField",
        "getMetadata",
        "getMetadataString",
        "getObjectType",
        "getParagraphText",
        "getParagraphXML",
        "getProductName",
        "getPureText",
        "getSelectedElement",
        "getSelectedElementXpath",
        "getSelectedText",
        "getSelectedXML",
        "getSystemMetadata",
        "getSystemMetadataString",
        "getTextAtXpath",
        "getTextContent",
        "getUsageTickets",
        "getUsageTicketsString",
        "getUserFullName",
        "getUserGroups",
        "getUserMetadata",
        "getUserMetadataString",
        "getUserName",
        "getUserSystemMetadata",
        "getUserSystemMetadataString",
        "getUserTeams",
        "getVirtualAttributes",
        "getVirtualAttributesString",
        "getWorkflowStatus",
        "getXmlAtXpath",
        "getXmlContent",
        "highlightTextSegments",
        "insertTextAtCursor",
        "insertTextAtXpath",
        "insertXmlAtCursor",
        "insertXmlAtXpath",
        "isReadonly",
        "isTextSelected",
        "listAvailableTools",
        "markSegments",
        "markdownToHtml",
        "readCurrentParagraph",
        "readSelection",
        "readStory",
        "replaceCurrentParagraph",
        "replaceTextAtCursor",
        "replaceTextAtCursorParagraph",
        "replaceTextAtXpath",
        "replaceXmlAtCursor",
        "replaceXmlAtCursorParagraph",
        "replaceXmlAtXpath",
        "searchAndReplaceText",
        "setField",
        "showNotification",
        "updateProgress",
        "validateAndRepairXml",
        "xmlToMarkdown"
      ],
      "description": "Enable all tools from a class by specifying the class name, or enable a single tool by its name"
    },
    {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "ContentTools",
            "ContainerInfoTools",
            "CustomTools",
            "DocumentInfoTools",
            "FeedbackTools",
            "HighlightTools",
            "StoryEditor",
            "HubMcp",
            "ToolDiscovery",
            "UserInfoTools",
            "UserInteractionTools",
            "UtilityTools"
          ],
          "description": "Tool class name"
        },
        "only": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Only enable these specific tools from the class (optional). Accepts raw tool names or provider namespaced names (<toolClass>__<tool>)."
        },
        "xpaths": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Named XPath mappings available as tool parameters (optional)"
        },
        "when": {
          "type": [
            "string",
            "boolean"
          ],
          "description": "Optional condition evaluated once when the request/session is built (template expression like '{{ client.isTextSelected() }}' or boolean). When falsy, the entry is neither advertised to the model nor executable."
        },
        "config": {
          "type": "object",
          "description": "Provider configuration, validated against the provider's declared config options (unknown keys warn but never fail). Values support template expressions resolved once when the request/session is built."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "StoryEditor"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "description": "Configuration options for StoryEditor",
                "properties": {
                  "bodyXpath": {
                    "type": "string",
                    "description": "XPath of the content root that searchAndReplaceText reads and writes",
                    "default": "/doc/story"
                  },
                  "appendXpath": {
                    "type": "string",
                    "description": "XPath of the element appendParagraph inserts new paragraphs into",
                    "default": "/doc/story/text"
                  },
                  "allowedElements": {
                    "type": "array",
                    "description": "XML elements allowed in searchAndReplaceText replacement content",
                    "default": [
                      "p",
                      "h2",
                      "h3",
                      "ul",
                      "li",
                      "b",
                      "i",
                      "u"
                    ]
                  },
                  "inlineElements": {
                    "type": "array",
                    "description": "Inline formatting elements allowed in appendParagraph text",
                    "default": [
                      "b",
                      "i",
                      "u"
                    ]
                  },
                  "fields": {
                    "type": "object",
                    "description": "Map of semantic field names to xpaths (e.g. headline: /doc/story/grouphead/headline/p). Generates the getField/setField tools with the field names as an enum; both tools are dropped when no fields are configured."
                  },
                  "markTag": {
                    "type": "string",
                    "description": "Tag name used by markSegments/clearMarks",
                    "default": "mark"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "alias"
      ],
      "anyOf": [
        {
          "required": [
            "target"
          ]
        },
        {
          "required": [
            "extend"
          ]
        }
      ],
      "properties": {
        "alias": {
          "type": "string",
          "description": "Name of the new virtual tool (the alias namespace is added automatically)"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Underlying tool to call when this alias is invoked (supports <tool>, <toolClass>__<tool>, <toolClass>.<tool>, mcp__<server>__<tool>, mcp.<server>.<tool>)"
        },
        "extend": {
          "type": "string",
          "description": "Optional alias template name to extend"
        },
        "description": {
          "type": "string",
          "description": "Optional description override for the AI (replaces the original tool description)"
        },
        "args": {
          "type": "object",
          "description": "Preset arguments to pass to the underlying tool (merged with AI-provided arguments)"
        },
        "when": {
          "type": [
            "string",
            "boolean"
          ],
          "description": "Optional condition evaluated once when the request/session is built (template expression like '{{ client.isTextSelected() }}' or boolean). When falsy, the alias is neither advertised to the model nor executable."
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "aliasTemplate",
        "target"
      ],
      "properties": {
        "aliasTemplate": {
          "type": "string",
          "description": "Name of the alias template (used by aliases via extend)"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Underlying tool to call when this template is used (supports <tool>, <toolClass>__<tool>, <toolClass>.<tool>, mcp__<server>__<tool>, mcp.<server>.<tool>)"
        },
        "description": {
          "type": "string",
          "description": "Optional description for aliases extending this template"
        },
        "args": {
          "type": "object",
          "description": "Preset arguments applied by aliases extending this template"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "mcp"
      ],
      "properties": {
        "mcp": {
          "type": "string",
          "description": "MCP server name as registered in the Hub"
        },
        "only": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional list of MCP tool names to expose (accepts <tool>, mcp__<server>__<tool>, mcp.<server>.<tool>, or <server>.<tool>)"
        },
        "when": {
          "type": [
            "string",
            "boolean"
          ],
          "description": "Optional condition evaluated once when the request/session is built (template expression like '{{ client.isTextSelected() }}' or boolean). When falsy, the MCP tools are neither advertised to the model nor executable."
        }
      },
      "additionalProperties": false
    }
  ]
}